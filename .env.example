# Environment Variables

# Required for production
# Set these in Railway Dashboard → Your Service → Variables

# ─── Application ─────────────────────────────────────────────────────────────

# Node environment (set automatically by Railway)
NODE_ENV=production

# Database path (Railway has ephemeral storage; todos reset on redeploy)
# For persistent storage, migrate to PostgreSQL
DB_PATH=./todos.db

# Port (set automatically by Railway — do not change)
# PORT=3000
